# cluster.env — describe YOUR Sparks. ./setup.sh writes the detected values for you; cluster.env is git-ignored.
# Every node needs this repo at the same absolute path (./setup.sh copies it).
# Shell syntax: this file is sourced by bash. A variable set in the environment overrides it for one run.

# ---- nodes ------------------------------------------------------------------------------------------
# SSH names, head first. The head is where you run ./run.sh and where the API is served.
{{NODES_COMMENT}}
NODES=(spark1 spark2 spark3)

# ---- model --------------------------------------------------------------------------------------------
# Local NVMe path of the checkpoint, same on every node (./setup.sh downloads it here).
MODEL_DIR={{MODEL_DIR}}

# ---- serving ------------------------------------------------------------------------------------------
PORT=8000
SERVED_NAMES="{{SERVED}}"                  # space-separated aliases
CONTAINER_NAME={{CONTAINER}}
CACHE_DIR=/var/tmp/{{SLUG}}-vllm-cache      # torch/triton/flashinfer caches, per node

# ---- TP2: one QSFP cable between NODES[0] and NODES[1] ----------------------------------------------------
# The fabric IPs you gave the two cabled CX7 ports, and which port/HCA that is on each node
# (ibdev2netdev prints the HCA <-> interface mapping). The ports may differ between the two nodes.
TP2_HEAD_IP=10.10.20.1
TP2_WORKER_IP=10.10.20.2
TP2_SUBNET=10.10.20.0/24
TP2_HEAD_IF=enp1s0f0np0
TP2_HEAD_HCA=rocep1s0f0
TP2_WORKER_IF=enp1s0f1np1
TP2_WORKER_HCA=rocep1s0f1
# NCCL finds the IPv4 RoCE v2 GID from TP2_SUBNET. Only if that fails, pin it (show_gids; on DGX OS 7 usually 5,
# while 3 is IPv6 link-local):
#IB_GID_INDEX_TP2=5

# ---- TP3: three QSFP cables in a triangle (each node's two ports go to its two neighbours) ---------------
# NCCL bootstraps over the normal LAN and moves data over both CX7 ports. LAN_IPS are the NODES' LAN addresses.
LAN_IF=enP7s7
LAN_IPS=(192.168.1.101 192.168.1.102 192.168.1.103)   # example — setup.sh fills in yours
TP3_HCAS=rocep1s0f0,rocep1s0f1
# RoCE v2 GID index of the IPv4 GID on the HCAs (show_gids). On DGX OS 7 it is usually 5; 3 is IPv6 link-local.
IB_GID_INDEX=5
